{
  "name": "os-code",
  "version": "0.1.0",
  "description": "OS Code (Open Shore Code): a terminal-first coding agent for your own stack of local LLMs. Your machine, your models, your keys.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "osc": "./dist/bin/osc.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@octokit/rest": "22.0.1",
    "commander": "15.0.0",
    "ink": "5.2.1",
    "linkedom": "0.18.13",
    "qrcode-terminal": "0.12.0",
    "react": "18.3.1",
    "simple-git": "3.36.0",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "18.3.31",
    "@types/turndown": "5.0.6",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./protocol": "./dist/src/protocol.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./catalog.sample.json": "./catalog.sample.json"
  }
}
