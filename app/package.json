{
  "name": "oscode-app",
  "private": true,
  "version": "0.1.0",
  "description": "OpenShore: the native app. Chat and build with your own stack of local LLMs.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint src electron --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -w node-pty -m ../os-code || echo 'electron-rebuild skipped: node-pty stays built for system Node; the desktop terminal needs it rebuilt for Electron, run pnpm --filter oscode-app rebuild:native'",
    "rebuild:native": "electron-rebuild -f -w node-pty -m ../os-code",
    "desktop": "vite build && tsc -p electron/tsconfig.json && electron .",
    "package:linux": "vite build && tsc -p electron/tsconfig.json && electron-builder --linux",
    "package:mac": "vite build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "package:win": "vite build && tsc -p electron/tsconfig.json && electron-builder --win",
    "ios:sync": "vite build && cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "highlight.js": "11.12.0",
    "os-code": "workspace:*",
    "oscode-iap": "file:./plugins/oscode-iap",
    "oscode-icloud": "file:./plugins/oscode-icloud",
    "oscode-llama": "file:./plugins/oscode-llama",
    "oscode-speech": "file:./plugins/oscode-speech",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@electron/rebuild": "4.2.0",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "4.6.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "ai.openshore.oscode",
    "productName": "OpenShore",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "OpenShore",
        "schemes": [
          "oscode"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "OpenShore Labs"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
