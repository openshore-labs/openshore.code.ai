<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>OpenShore</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Custom URL scheme for Supabase auth callbacks: magic-link and
	     email-confirmation links redirect to oscode://auth-callback, which
	     opens the app and is handled by useAuthDeepLink. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.openshore.oscode.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oscode</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  The phone talks to the user's own desktop daemon over Tailscale
		  (100.64.0.0/10 CGNAT addresses) and LAN IPs, plain HTTP inside the
		  private tunnel. NSAllowsLocalNetworking does not cover the CGNAT range
		  and the daemon has no public hostname to scope an NSExceptionDomains
		  entry to, so the blanket flag is required and is kept on deliberately.
		  Every provider call (Hugging Face, Anthropic, Supabase) is still https.
		  App Review justification and the reasoning for not narrowing it:
		  docs/app-review-notes.md. Do NOT flip this without updating that doc.
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenShore connects to the OpenShore daemon running on your own desktop over your local network or Tailscale.</string>
	<key>NSCameraUsageDescription</key>
	<string>OpenShore uses the camera only to scan the pairing QR code shown on your computer, so you never have to type the address and token by hand.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenShore uses the microphone to turn your speech into text when you tap the mic in the composer.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OpenShore transcribes your speech on this device so you can dictate messages. The audio stays on your phone.</string>
	<!-- Only standard TLS; skips the export-compliance question on each TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!--
	  Name the app's iCloud Drive container and make its Documents folder public
	  in the Files app, so a Vault stored on iCloud shows up as "OpenShore" under
	  iCloud Drive and Obsidian mobile can open it. Pairs with the iCloud
	  entitlement in App.entitlements.
	-->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.ai.openshore.oscode</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>OpenShore</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
