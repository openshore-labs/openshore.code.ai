<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the SIGNED macOS build only (used when the
  Developer ID secrets are present; see codemagic.yaml mac-desktop and
  docs/MAC-DESKTOP.md). The unsigned default build never reads this file.
  Electron's V8 needs JIT and writable executable memory; the bundled engine
  loads node-pty, a native module built on the build machine, which library
  validation would otherwise refuse.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
