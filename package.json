{
  "name": "openshore-code",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "OpenShore: an open source coding agent on your own computer or server, with the model you choose. Desktop, terminal and iPhone.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "desktop": "pnpm --filter os-code build && pnpm --filter oscode-app desktop"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "@xmldom/xmldom@>=0.7.0 <0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "undici@>=6.0.0 <6.28.1": "6.29.0",
      "undici@>=7.0.0 <7.29.1": "7.30.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2"
    }
  }
}
